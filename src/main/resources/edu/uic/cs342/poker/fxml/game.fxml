<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.uic.cs342.poker.controller.GameController"
      alignment="CENTER"
      spacing="18"
      prefWidth="750"
      prefHeight="500"
      styleClass="welcome-root">

    <padding>
        <Insets top="25" bottom="25" left="25" right="25"/>
    </padding>

    <Label text="Three Card Poker"
           styleClass="welcome-label"/>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Ante Bet:"/>

        <TextField fx:id="anteField"
                   text="10"
                   prefWidth="90"/>

        <Label text="Pair Plus:"/>

        <TextField fx:id="pairPlusField"
                   text="0"
                   prefWidth="90"/>

        <Button fx:id="startRoundButton"
                text="Start Round"
                onAction="#handleStartRound"/>
    </HBox>

    <Label fx:id="dealerCardsLabel"
           text="Dealer cards hidden"
           wrapText="true"/>

    <Label fx:id="playerCardsLabel"
           text="No cards dealt"
           wrapText="true"/>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="playButton"
                text="Play"
                onAction="#handlePlay"/>

        <Button fx:id="foldButton"
                text="Fold"
                onAction="#handleFold"/>
    </HBox>

    <Label fx:id="resultLabel"
           text="Enter your bets to begin"/>

    <Label fx:id="profitLabel"
           text=""/>

    <Label fx:id="totalProfitLabel"
           text="Total Profit: 0"/>

</VBox>

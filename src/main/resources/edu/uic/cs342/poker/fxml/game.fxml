<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.uic.cs342.poker.controller.GameController"
      alignment="CENTER"
      spacing="14"
      prefWidth="850"
      prefHeight="680"
      styleClass="poker-root">

    <padding>
        <Insets top="25" bottom="25" left="25" right="25"/>
    </padding>

    <Label text="THREE CARD POKER"
           styleClass="table-title"/>

    <HBox alignment="CENTER" spacing="12">
        <Label text="Ante Bet:"/>

        <TextField fx:id="anteField"
                   text="10"
                   prefWidth="85"/>

        <Label text="Pair Plus:"/>

        <TextField fx:id="pairPlusField"
                   text="0"
                   prefWidth="85"/>

        <Button fx:id="startRoundButton"
                text="Start Round"
                onAction="#handleStartRound"/>
    </HBox>

    <Label text="DEALER" styleClass="section-heading"/>

    <HBox fx:id="dealerCardsBox"
          alignment="CENTER"
          spacing="12"
          minHeight="120"/>

    <Label text="YOUR HAND" styleClass="section-heading"/>

    <HBox fx:id="playerCardsBox"
          alignment="CENTER"
          spacing="12"
          minHeight="120"/>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="playButton"
                text="Play"
                onAction="#handlePlay"/>

        <Button fx:id="foldButton"
                text="Fold"
                onAction="#handleFold"/>
    </HBox>

    <Label fx:id="resultLabel"
           text="Enter your bets to begin"
           styleClass="status-label"/>

    <Label fx:id="profitLabel" text=""/>

    <Label fx:id="totalProfitLabel"
           text="Total Profit: 0"
           styleClass="total-profit"/>

</VBox>
